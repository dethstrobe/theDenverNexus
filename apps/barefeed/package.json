{
  "name": "barefeed",
  "version": "1.0.0",
  "description": "Open source data aggregation.",
  "main": "index.js",
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "vite build",
    "check": "npm run generate && npm run types",
    "clean": "npm run clean:vite",
    "clean:vite": "rm -rf ./node_modules/.vite",
    "dev": "NODE_ENV=${NODE_ENV:-development} vite dev",
    "dev:init": "rw-scripts dev-init",
    "doc": "TEST2DOC=true playwright test --config=playwright-test2doc.config.ts",
    "generate": "rw-scripts ensure-env && prisma generate && wrangler types",
    "migrate:dev": "prisma generate && wrangler d1 migrations apply DB --local",
    "migrate:new": "rw-scripts migrate-new",
    "migrate:prd": "wrangler d1 migrations apply DB --remote",
    "prepare": "vibe-rules install cursor",
    "preview": "vite preview",
    "release": "rw-scripts ensure-deploy-env && npm run clean && prisma generate && RWSDK_DEPLOY=1 npm run build && wrangler deploy",
    "seed": "pnpm run worker:run ./src/scripts/seed.ts",
    "test": "vitest",
    "test:ci": "playwright test --reporter=list",
    "test:ui": "playwright test --ui",
    "types": "tsc",
    "worker:run": "rw-scripts worker-run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@prisma/adapter-d1": "~6.17.1",
    "@prisma/client": "~6.18.0",
    "@simplewebauthn/browser": "^13.1.0",
    "@simplewebauthn/server": "^13.1.1",
    "@tailwindcss/vite": "^4.1.11",
    "idb": "^8.0.3",
    "rwsdk": "0.3.11",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.5",
    "@playwright/test": "^1.54.1",
    "@test2doc/playwright": "^0.11.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^4.0.5",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^27.0.0",
    "msw": "^2.10.2",
    "prisma": "~6.17.0",
    "typescript": "^5.9.2",
    "vibe-rules": "^0.3.50",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.22.0"
  }
}
