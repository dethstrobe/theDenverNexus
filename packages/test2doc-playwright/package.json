{
  "name": "@test2doc/playwright",
  "version": "1.0.1",
  "description": "A reporter that generates docs based off playwright test files",
  "keywords": [
    "documentation",
    "document",
    "living documentation",
    "markdown",
    "generation",
    "generator",
    "docs",
    "test",
    "playwright",
    "docusaurus",
    "reporter",
    "automation"
  ],
  "homepage": "https://test2doc.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dethstrobe/theDenverNexus.git",
    "directory": "packages/test2doc-playwright"
  },
  "license": "GPL-3.0-or-later",
  "author": "@dethstrobe",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./DocMeta": {
      "import": "./dist/DocMeta.js",
      "require": "./dist/DocMeta.js",
      "types": "./dist/DocMeta.d.ts"
    },
    "./screenshots": {
      "import": "./dist/screenshots.js",
      "require": "./dist/screenshots.js",
      "types": "./dist/screenshots.d.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "dist/DocMeta.js",
    "dist/DocMeta.d.ts",
    "dist/screenshots.js",
    "dist/screenshots.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "clean": "rm -rf dist && rm -rf tsconfig.tsbuildinfo",
    "format": "biome format --write .",
    "int": "playwright test",
    "int:a": "playwright test --config=playwright-annotation.config.ts",
    "lint": "biome lint .",
    "postinstall": "pnpm playwright install",
    "test": "vitest run && pnpm int && pnpm int:a",
    "unit": "vitest"
  },
  "peerDependencies": {
    "@playwright/test": "^1.54.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
