{
  "name": "@test2doc/playwright",
  "version": "0.5.2",
  "description": "A reporter that generates docs based off playwright test files",
  "keywords": [
    "documentation",
    "document",
    "living documentation",
    "markdown",
    "generation",
    "generator",
    "docs",
    "test",
    "playwright",
    "docusaurus",
    "reporter",
    "automation"
  ],
  "homepage": "https://github.com/dethstrobe/theDenverNexus/tree/main/packages/test2doc-playwright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dethstrobe/theDenverNexus.git",
    "directory": "packages/test2doc-playwright"
  },
  "license": "GPL-3.0-or-later",
  "author": "@dethstrobe",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./DocMeta": {
      "import": "./dist/DocMeta.js",
      "require": "./dist/DocMeta.js",
      "types": "./dist/DocMeta.d.ts"
    },
    "./screenshots": {
      "import": "./dist/screenshots.js",
      "require": "./dist/screenshots.js",
      "types": "./dist/screenshots.d.ts"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "dist/DocMeta.js",
    "dist/DocMeta.d.ts",
    "dist/screenshots.js",
    "dist/screenshots.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "test": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "peerDependencies": {
    "@playwright/test": "^1.52.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4",
    "@types/node": "^24.0.4"
  }
}
